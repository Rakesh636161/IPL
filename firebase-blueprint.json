{
  "entities": {
    "UserAccount": {
      "title": "UserAccount",
      "description": "Private authenticated user account record containing PII and immutable Unique Player ID.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 254,
          "description": "User email address (private PII)"
        },
        "uniquePlayerId": {
          "type": "string",
          "minLength": 4,
          "maxLength": 20,
          "pattern": "^CV[0-9]{6,}$",
          "description": "Immutable sequential CricketVerse Player ID (e.g., CV100001)"
        },
        "role": {
          "type": "string",
          "enum": ["USER", "ADMIN"],
          "description": "Application access role"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "uniquePlayerId", "role", "createdAt", "updatedAt"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "CricketVerse franchise owner public profile.",
