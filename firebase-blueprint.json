      "description": "Finalized player auction results keyed by {leagueId}__{playerId}."
    },
    "/team_purses/{purseId}": {
      "schema": { "$ref": "#/entities/TeamPurse" },
      "description": "Virtual integer purse and overseas slot state keyed by {leagueId}__{ownerId}."
    }
  }
}
